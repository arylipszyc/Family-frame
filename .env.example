# Google OAuth credentials for Google Photos sync
# Create a project in Google Cloud Console:
#   https://console.cloud.google.com
# Enable the "Photos Library API"
# Create OAuth 2.0 credentials:
#   - Android Client ID (for the native sign-in flow on device)
#   - Web Application Client ID + Secret (for server-side token exchange)
#
# Use the Web Application Client ID as VITE_GOOGLE_WEB_CLIENT_ID

VITE_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_SECRET=your-client-secret
